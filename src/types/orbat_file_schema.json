            "PclMeasurementModel": {
                "description": "Measurement model for PCL detections.\n\nThis model implements the Cram\u00e9r-Rao Bound (CRB) of the uncertainty.\n\nNotes\n-----\nThis class implements Equ. (22) of the following article:\nA. Quazi, \"An overview on the time delay estimate in active and passive\nsystems for target localization,\"\nin IEEE Transactions on Acoustics, Speech, and Signal Processing,\nvol. 29, no. 3, pp. 527-533, June 1981, doi: 10.1109/TASSP.1981.1163618.",
                "properties": {
                    "min_bistatic_range_uncertainty": {
                        "default": 0.0,
                        "title": "Min Bistatic Range Uncertainty",
                        "type": "number"
                    },
                    "max_bistatic_range_uncertainty": {
                        "default": 10000.0,
                        "title": "Max Bistatic Range Uncertainty",
                        "type": "number"
                    },
                    "min_doppler_uncertainty": {
                        "default": 0.0,
                        "title": "Min Doppler Uncertainty",
                        "type": "number"
                    },
                    "max_doppler_uncertainty": {
                        "default": 10000.0,
                        "title": "Max Doppler Uncertainty",
                        "type": "number"
                    }
                },
                "title": "PclMeasurementModel",
                "type": "object"
            },
