{"openapi": "3.1.0", "info": {"title": "Theia", "version": "0.0.0"}, "paths": {}, "components": {"schemas": {"OrderOfBattle": {"properties": {"monostatic_sensors": {"items": {"$ref": "#/components/schemas/MonostaticSensorFactory"}, "title": "Monostatic Sensors", "type": "array"}, "pcl_sensors": {"items": {"$ref": "#/components/schemas/PclSensorFactory"}, "title": "Pcl Sensors", "type": "array"}, "gbads": {"items": {"$ref": "#/components/schemas/StaticGbadFactory"}, "title": "Gbads", "type": "array"}, "simulationResults": {"$ref": "#/components/schemas/SimulationResults"}, "oneway_drones": {"items": {"$ref": "#/components/schemas/FixedPathOneWayDroneFactory"}, "title": "Oneway Drones", "type": "array"}, "ballistic_missiles": {"items": {"$ref": "#/components/schemas/BallisticMissileFactory"}, "title": "Ballistic Missiles", "type": "array"}, "critical_infrastructure": {"default": [], "items": {"$ref": "#/components/schemas/CriticalInfrastructureFactory"}, "title": "Critical Infrastructure", "type": "array"}, "cruise_missiles": {"default": [], "items": {"$ref": "#/components/schemas/CruiseMissileFactory"}, "title": "Cruise Missiles", "type": "array"}, "camp_sites": {"default": [], "items": {"$ref": "#/components/schemas/CampSite"}, "title": "Camp Sites", "type": "array"}, "transport_times": {"default": [], "items": {"$ref": "#/components/schemas/TransportTime"}, "title": "Transport Times", "type": "array"}, "intel": {"default": [], "items": {"discriminator": {"mapping": {"known_target": "#/components/schemas/KnownTargetFactory", "shooter_reveal": "#/components/schemas/ShooterRevealFactory"}, "propertyName": "type"}, "oneOf": [{"$ref": "#/components/schemas/ShooterRevealFactory"}, {"$ref": "#/components/schemas/KnownTargetFactory"}]}, "title": "Intel", "type": "array"}, "unused_id_sensor": {"title": "Unused Id Sensor", "type": "integer"}, "unused_id_receiver": {"title": "Unused Id Receiver", "type": "integer"}, "unused_id_transmitter": {"title": "Unused Id Transmitter", "type": "integer"}, "unused_id_effector": {"title": "Unused Id Effector", "type": "integer"}, "unused_target_id": {"title": "Unused Target Id", "type": "integer"}, "unused_id_camp_site": {"default": 0, "title": "Unused Id Camp Site", "type": "integer"}, "is_user_controlled": {"default": false, "title": "Is User Controlled", "type": "boolean"}}, "required": ["monostatic_sensors", "pcl_sensors", "gbads", "simulationResults", "oneway_drones", "ballistic_missiles", "unused_id_sensor", "unused_id_receiver", "unused_id_transmitter", "unused_id_effector", "unused_target_id"], "title": "OrderOfBattle", "type": "object"}, "AntennaDiagramFactory": {"properties": {"name": {"enum": ["none", "csc_2deg"], "title": "Name", "type": "string"}}, "required": ["name"], "title": "AntennaDiagramFactory", "type": "object"}, "AttenuationModel": {"description": "Representation of an antenna attenuation diagram.\n\nActually represents the squared attenuation coefficients :math:`F_t, F_r`.", "properties": {"attenuation_table_angles": {"items": {"type": "number"}, "title": "Attenuation Table Angles", "type": "array"}, "attenuation_table_values": {"items": {"type": "number"}, "title": "Attenuation Table Values", "type": "array"}, "polarization": {"$ref": "#/components/schemas/Polarization"}}, "required": ["attenuation_table_angles", "attenuation_table_values", "polarization"], "title": "AttenuationModel", "type": "object"}, "BallisticMissileFactory": {"properties": {"p_start": {"$ref": "#/components/schemas/Point"}, "p_stop": {"$ref": "#/components/schemas/Point"}, "t_start": {"format": "date-time", "title": "T Start", "type": "string"}, "terrain": {"$ref": "#/components/schemas/TerrainFactory"}, "target_id": {"title": "Target Id", "type": "integer"}, "effector_id": {"title": "Effector Id", "type": "integer"}, "rcs": {"title": "Rcs", "type": "number"}, "alpha": {"anyOf": [{"type": "number"}, {"type": "null"}], "default": 45.0, "title": "Alpha"}, "category": {"$ref": "#/components/schemas/TargetCategory", "default": "SHORT_RANGE_BALLISTIC_MISSILE"}}, "required": ["p_start", "p_stop", "t_start", "terrain", "target_id", "effector_id", "rcs"], "title": "BallisticMissileFactory", "type": "object"}, "BallisticMissileTemplate": {"properties": {"rcs": {"title": "Rcs", "type": "number"}, "type": {"const": "ballistic_missile", "default": "ballistic_missile", "title": "Type", "type": "string"}, "category": {"$ref": "#/components/schemas/TargetCategory", "default": "SHORT_RANGE_BALLISTIC_MISSILE"}}, "required": ["rcs"], "title": "BallisticMissileTemplate", "type": "object"}, "CampSite": {"description": "Place where a side keeps counted stock of one ammunition type.\n\nA launch site (``can_launch=True``) can launch its stock; a depot cannot.\nThe site itself is a target: if it is destroyed, its stock is lost.", "properties": {"id": {"title": "Id", "type": "integer"}, "name": {"title": "Name", "type": "string"}, "point": {"$ref": "#/components/schemas/Point"}, "target_id": {"title": "Target Id", "type": "integer"}, "rcs": {"title": "Rcs", "type": "number"}, "n_ammo": {"minimum": 0, "title": "N Ammo", "type": "integer"}, "ammo": {"discriminator": {"mapping": {"ballistic_missile": "#/components/schemas/BallisticMissileTemplate", "cruise_missile": "#/components/schemas/CruiseMissileTemplate", "oneway_drone": "#/components/schemas/OneWayDroneTemplate"}, "propertyName": "type"}, "oneOf": [{"$ref": "#/components/schemas/BallisticMissileTemplate"}, {"$ref": "#/components/schemas/CruiseMissileTemplate"}, {"$ref": "#/components/schemas/OneWayDroneTemplate"}], "title": "Ammo"}, "can_launch": {"title": "Can Launch", "type": "boolean"}, "seconds_between_launches": {"minimum": 0, "title": "Seconds Between Launches", "type": "number"}}, "required": ["id", "name", "point", "target_id", "rcs", "n_ammo", "ammo", "can_launch", "seconds_between_launches"], "title": "CampSite", "type": "object"}, "ConstantRcsModel": {"properties": {"rcs": {"title": "Rcs", "type": "number"}}, "required": ["rcs"], "title": "ConstantRcsModel", "type": "object"}, "CriticalInfrastructureFactory": {"properties": {"target_id": {"title": "Target Id", "type": "integer"}, "name": {"title": "Name", "type": "string"}, "point": {"$ref": "#/components/schemas/Point"}, "rcs": {"default": 100.0, "title": "Rcs", "type": "number"}, "tags": {"default": [], "items": {"type": "string"}, "title": "Tags", "type": "array", "uniqueItems": true}}, "required": ["target_id", "name", "point"], "title": "CriticalInfrastructureFactory", "type": "object"}, "CruiseMissileFactory": {"description": "Terrain-following cruise missile, see :mod:`theia.cruise_missile`.\n\nThe altitudes of ``p_start`` and ``p_stop`` are ignored: the missile starts\nat least ``cruise_magl`` above the terrain (higher if needed to clear the\nterrain right after the launch) and hits the terrain at the target.", "properties": {"p_start": {"$ref": "#/components/schemas/Point"}, "p_stop": {"$ref": "#/components/schemas/Point"}, "t_start": {"format": "date-time", "title": "T Start", "type": "string"}, "terrain": {"$ref": "#/components/schemas/TerrainFactory"}, "target_id": {"title": "Target Id", "type": "integer"}, "effector_id": {"title": "Effector Id", "type": "integer"}, "rcs": {"title": "Rcs", "type": "number"}, "speed": {"title": "Speed", "type": "number"}, "cruise_magl": {"title": "Cruise Magl", "type": "number"}, "min_flight_path_angle": {"default": -10.0, "title": "Min Flight Path Angle", "type": "number"}, "max_flight_path_angle": {"default": 15.0, "title": "Max Flight Path Angle", "type": "number"}, "terminal_dive_angle": {"default": -30.0, "title": "Terminal Dive Angle", "type": "number"}, "min_clearance": {"anyOf": [{"type": "number"}, {"type": "null"}], "default": null, "title": "Min Clearance"}, "sample_spacing": {"default": 100.0, "title": "Sample Spacing", "type": "number"}, "category": {"$ref": "#/components/schemas/TargetCategory", "default": "CRUISE_MISSILE"}}, "required": ["p_start", "p_stop", "t_start", "terrain", "target_id", "effector_id", "rcs", "speed", "cruise_magl"], "title": "CruiseMissileFactory", "type": "object"}, "CruiseMissileTemplate": {"properties": {"rcs": {"title": "Rcs", "type": "number"}, "type": {"const": "cruise_missile", "default": "cruise_missile", "title": "Type", "type": "string"}, "speed": {"exclusiveMinimum": 0, "title": "Speed", "type": "number"}, "category": {"$ref": "#/components/schemas/TargetCategory", "default": "CRUISE_MISSILE"}}, "required": ["rcs", "speed"], "title": "CruiseMissileTemplate", "type": "object"}, "DirectFireEffectorFactory": {"properties": {"type": {"const": "direct", "default": "direct", "title": "Type", "type": "string"}, "id": {"title": "Id", "type": "integer"}, "name": {"title": "Name", "type": "string"}, "point": {"$ref": "#/components/schemas/Point"}, "combat_range": {"title": "Combat Range", "type": "number"}, "n_attacks_left": {"title": "N Attacks Left", "type": "integer"}, "cadence": {"title": "Cadence", "type": "number"}}, "required": ["id", "name", "point", "combat_range", "n_attacks_left", "cadence"], "title": "DirectFireEffectorFactory", "type": "object"}, "FixedPathOneWayDroneFactory": {"properties": {"effector": {"$ref": "#/components/schemas/DirectFireEffectorFactory"}, "trajectory": {"$ref": "#/components/schemas/Trajectory"}, "assigned_goal": {"$ref": "#/components/schemas/Point"}}, "required": ["effector", "trajectory", "assigned_goal"], "title": "FixedPathOneWayDroneFactory", "type": "object"}, "GeoJSONFeature": {"properties": {"type": {"const": "Feature", "default": "Feature", "title": "Type", "type": "string"}, "geometry": {"discriminator": {"mapping": {"MultiPolygon": "#/components/schemas/GeoJSONMultiPolygon", "Polygon": "#/components/schemas/GeoJSONPolygon"}, "propertyName": "type"}, "oneOf": [{"$ref": "#/components/schemas/GeoJSONPolygon"}, {"$ref": "#/components/schemas/GeoJSONMultiPolygon"}], "title": "Geometry"}, "properties": {"type": "object", "additionalProperties": true, "default": {}, "title": "Properties"}}, "required": ["geometry"], "title": "GeoJSONFeature", "type": "object"}, "GeoJSONMultiPolygon": {"properties": {"type": {"const": "MultiPolygon", "default": "MultiPolygon", "title": "Type", "type": "string"}, "coordinates": {"items": {"items": {"items": {"items": {"type": "number"}, "type": "array"}, "type": "array"}, "type": "array"}, "title": "Coordinates", "type": "array"}}, "required": ["coordinates"], "title": "GeoJSONMultiPolygon", "type": "object"}, "GeoJSONPolygon": {"properties": {"type": {"const": "Polygon", "default": "Polygon", "title": "Type", "type": "string"}, "coordinates": {"items": {"items": {"items": {"type": "number"}, "type": "array"}, "type": "array"}, "title": "Coordinates", "type": "array"}}, "required": ["coordinates"], "title": "GeoJSONPolygon", "type": "object"}, "IndirectFireEffectorFactory": {"properties": {"type": {"const": "indirect", "default": "indirect", "title": "Type", "type": "string"}, "id": {"title": "Id", "type": "integer"}, "name": {"title": "Name", "type": "string"}, "point": {"$ref": "#/components/schemas/Point"}, "combat_range": {"title": "Combat Range", "type": "number"}, "n_attacks_left": {"title": "N Attacks Left", "type": "integer"}, "cadence": {"title": "Cadence", "type": "number"}, "projectile": {"$ref": "#/components/schemas/DirectFireEffectorFactory"}, "projectile_speed": {"title": "Projectile Speed", "type": "number"}, "projectile_max_dist": {"title": "Projectile Max Dist", "type": "number"}, "projectile_rcs": {"$ref": "#/components/schemas/ConstantRcsModel"}, "max_in_flight": {"default": 1, "title": "Max In Flight", "type": "integer"}}, "required": ["id", "name", "point", "combat_range", "n_attacks_left", "cadence", "projectile", "projectile_speed", "projectile_max_dist", "projectile_rcs"], "title": "IndirectFireEffectorFactory", "type": "object"}, "KnownTargetFactory": {"description": "Lasting intel about a stationary enemy target, e.g. a facility.\n\nBuilds a ``KnownTargetController`` that reports the target for the whole\nsimulation. ``point`` and ``target_info`` are this side's belief and are\nused as given (including the party); they need not match a real target.\nThe IDs of the reported target are assigned when the simulation starts,\nso the file holds none.", "properties": {"type": {"const": "known_target", "default": "known_target", "title": "Type", "type": "string"}, "name": {"default": "", "title": "Name", "type": "string"}, "point": {"$ref": "#/components/schemas/Point"}, "target_info": {"$ref": "#/components/schemas/TargetInfo"}}, "required": ["point", "target_info"], "title": "KnownTargetFactory", "type": "object"}, "LatLonHeightGrid": {"properties": {"lat_start": {"title": "Lat Start", "type": "number"}, "lat_stop": {"title": "Lat Stop", "type": "number"}, "lat_res": {"title": "Lat Res", "type": "number"}, "lon_start": {"title": "Lon Start", "type": "number"}, "lon_stop": {"title": "Lon Stop", "type": "number"}, "lon_res": {"title": "Lon Res", "type": "number"}, "height_start": {"title": "Height Start", "type": "number"}, "height_stop": {"title": "Height Stop", "type": "number"}, "height_res": {"title": "Height Res", "type": "number"}}, "required": ["lat_start", "lat_stop", "lat_res", "lon_start", "lon_stop", "lon_res", "height_start", "height_stop", "height_res"], "title": "LatLonHeightGrid", "type": "object"}, "MonostaticCoverageCalcSettings": {"properties": {"targetAlt": {"title": "Targetalt", "type": "number"}, "targetRcs": {"title": "Targetrcs", "type": "number"}, "probabilityThreshold": {"title": "Probabilitythreshold", "type": "number"}, "latRes": {"title": "Latres", "type": "number"}, "lonRes": {"title": "Lonres", "type": "number"}}, "required": ["targetAlt", "targetRcs", "probabilityThreshold", "latRes", "lonRes"], "title": "MonostaticCoverageCalcSettings", "type": "object"}, "MonostaticCoverageCalculation": {"properties": {"sensorId": {"title": "Sensorid", "type": "integer"}, "settings": {"$ref": "#/components/schemas/MonostaticCoverageCalcSettings"}, "coverage": {"items": {"$ref": "#/components/schemas/GeoJSONFeature"}, "title": "Coverage", "type": "array"}}, "required": ["sensorId", "settings", "coverage"], "title": "MonostaticCoverageCalculation", "type": "object"}, "MonostaticRadarMeasurementModel": {"properties": {"min_range_uncertainty": {"default": 100.0, "title": "Min Range Uncertainty", "type": "number"}, "max_range_uncertainty": {"default": 10000.0, "title": "Max Range Uncertainty", "type": "number"}, "min_angular_uncertainty": {"default": 0.017453292519943295, "title": "Min Angular Uncertainty", "type": "number"}, "max_angular_uncertainty": {"default": 6.283185307179586, "title": "Max Angular Uncertainty", "type": "number"}}, "title": "MonostaticRadarMeasurementModel", "type": "object"}, "MonostaticSensor": {"properties": {"id": {"title": "Id", "type": "integer"}, "transmitter": {"$ref": "#/components/schemas/Transmitter"}, "receiver": {"$ref": "#/components/schemas/Receiver"}, "error_model": {"$ref": "#/components/schemas/MonostaticRadarMeasurementModel"}}, "required": ["id", "transmitter", "receiver", "error_model"], "title": "MonostaticSensor", "type": "object"}, "MonostaticSensorFactory": {"properties": {"target_id": {"title": "Target Id", "type": "integer"}, "rcs": {"title": "Rcs", "type": "number"}, "sensor": {"$ref": "#/components/schemas/MonostaticSensor"}, "vertical_antenna_diagram": {"$ref": "#/components/schemas/AntennaDiagramFactory", "default": {"name": "none"}}, "name": {"default": "", "title": "Name", "type": "string"}}, "required": ["target_id", "rcs", "sensor"], "title": "MonostaticSensorFactory", "type": "object"}, "OneWayDroneTemplate": {"properties": {"rcs": {"title": "Rcs", "type": "number"}, "type": {"const": "oneway_drone", "default": "oneway_drone", "title": "Type", "type": "string"}, "speed": {"exclusiveMinimum": 0, "title": "Speed", "type": "number"}, "combat_range": {"default": 100.0, "title": "Combat Range", "type": "number"}}, "required": ["rcs", "speed"], "title": "OneWayDroneTemplate", "type": "object"}, "Party": {"description": "Party a target belongs to.", "enum": ["UNKNOWN", "BLUE", "RED", "NEUTRAL"], "title": "Party", "type": "string"}, "PclMeasurementModel": {"description": "Measurement model for PCL detections.\n\nThis model implements the Cram\u00e9r-Rao Bound (CRB) of the uncertainty.\n\nNotes\n-----\nThis class implements Equ. (22) of the following article:\nA. Quazi, \"An overview on the time delay estimate in active and passive\nsystems for target localization,\"\nin IEEE Transactions on Acoustics, Speech, and Signal Processing,\nvol. 29, no. 3, pp. 527-533, June 1981, doi: 10.1109/TASSP.1981.1163618.", "properties": {"min_bistatic_range_uncertainty": {"default": 0.0, "title": "Min Bistatic Range Uncertainty", "type": "number"}, "max_bistatic_range_uncertainty": {"default": 10000.0, "title": "Max Bistatic Range Uncertainty", "type": "number"}, "min_doppler_uncertainty": {"default": 0.0, "title": "Min Doppler Uncertainty", "type": "number"}, "max_doppler_uncertainty": {"default": 10000.0, "title": "Max Doppler Uncertainty", "type": "number"}}, "title": "PclMeasurementModel", "type": "object"}, "PclMinDetectableRcsCalcSettings": {"properties": {"grid": {"$ref": "#/components/schemas/LatLonHeightGrid"}, "snr_threshold": {"title": "Snr Threshold", "type": "number"}, "doppler_threshold": {"title": "Doppler Threshold", "type": "number"}, "delay_threshold": {"title": "Delay Threshold", "type": "number"}}, "required": ["grid", "snr_threshold", "doppler_threshold", "delay_threshold"], "title": "PclMinDetectableRcsCalcSettings", "type": "object"}, "PclMinDetectableRcsCalculation": {"properties": {"sensor_id": {"title": "Sensor Id", "type": "integer"}, "settings": {"$ref": "#/components/schemas/PclMinDetectableRcsCalcSettings"}, "values": {"items": {"items": {"items": {"type": "number"}, "type": "array"}, "type": "array"}, "title": "Values", "type": "array"}}, "required": ["sensor_id", "settings", "values"], "title": "PclMinDetectableRcsCalculation", "type": "object"}, "PclSensor": {"properties": {"id": {"title": "Id", "type": "integer"}, "transmitter": {"$ref": "#/components/schemas/Transmitter"}, "receiver": {"$ref": "#/components/schemas/Receiver"}, "error_model": {"$ref": "#/components/schemas/PclMeasurementModel"}}, "required": ["id", "transmitter", "receiver", "error_model"], "title": "PclSensor", "type": "object"}, "PclSensorFactory": {"properties": {"target_id": {"title": "Target Id", "type": "integer"}, "rcs": {"title": "Rcs", "type": "number"}, "sensor": {"$ref": "#/components/schemas/PclSensor"}}, "required": ["target_id", "rcs", "sensor"], "title": "PclSensorFactory", "type": "object"}, "Point": {"properties": {"lat": {"title": "Lat", "type": "number"}, "lon": {"title": "Lon", "type": "number"}, "alt": {"title": "Alt", "type": "number"}}, "required": ["lat", "lon", "alt"], "title": "Point", "type": "object"}, "Polarization": {"enum": [0, 1], "title": "Polarization", "type": "integer"}, "Receiver": {"properties": {"id": {"title": "Id", "type": "integer"}, "point": {"$ref": "#/components/schemas/Point"}, "antenna_height": {"title": "Antenna Height", "type": "number"}, "diameter": {"title": "Diameter", "type": "number"}, "cpi_pulses": {"title": "Cpi Pulses", "type": "number"}, "pfa": {"title": "Pfa", "type": "number"}, "min_elevation": {"title": "Min Elevation", "type": "number"}, "max_elevation": {"title": "Max Elevation", "type": "number"}, "min_azimuth": {"title": "Min Azimuth", "type": "number"}, "max_azimuth": {"title": "Max Azimuth", "type": "number"}, "rotation_time": {"title": "Rotation Time", "type": "number"}, "bandwidth": {"title": "Bandwidth", "type": "number"}, "gain": {"default": 0, "title": "Gain", "type": "number"}, "losses": {"default": 0, "title": "Losses", "type": "number"}, "noise_temperature": {"default": 300.0, "title": "Noise Temperature", "type": "number"}, "noise_figure": {"default": 1.9, "title": "Noise Figure", "type": "number"}, "ante